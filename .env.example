BOT_NAME=Demkinn
# V1.x is intentionally PAPER ONLY. There is no live execution path in this release.
STARTING_EQUITY_SOL=10

# Jupiter Developer Platform API key
JUPITER_API_KEY=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime
SCAN_INTERVAL_MS=15000
API_MIN_INTERVAL_MS=1150
DEMKINN_STATE_FILE=demkinn-state.json
DEMKINN_SCANS_FILE=demkinn-scans.jsonl
DEMKINN_PERFORMANCE_FILE=demkinn-performance.jsonl

# Risk
RISK_PER_TRADE_PCT=0.75
MAX_POSITION_PCT=1.50
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=4
MIN_TRADE_SOL=0.05
MAX_TRADE_SOL=0.50

# Candidate gates
MIN_LIQUIDITY_USD=75000
MAX_LIQUIDITY_USD=15000000
MIN_MARKET_CAP_USD=100000
MAX_MARKET_CAP_USD=30000000
MIN_HOLDERS=250
MIN_ORGANIC_SCORE=55
MAX_TOP_HOLDERS_PCT=25
MAX_DEV_BALANCE_PCT=5
MIN_BUY_SELL_RATIO=1.20
MIN_NET_BUYERS_5M=12
MIN_VOLUME_5M_USD=25000
MIN_MOMENTUM_5M_PCT=3
MAX_MOMENTUM_5M_PCT=35
MIN_TOKEN_AGE_MIN=5
MAX_TOKEN_AGE_HOURS=168

# Entry / exit model
ENTRY_SCORE_MIN=78
STOP_LOSS_PCT=12
TP1_PCT=25
TP1_SELL_PCT=40
TP2_PCT=60
TP2_SELL_PCT=30
TRAILING_ACTIVATION_PCT=12
TRAILING_STOP_PCT=15
TIME_STOP_MIN=45

# Paper execution realism
PAPER_FEE_BPS=10
PAPER_MAX_SLIPPAGE_BPS=80
PAPER_MIN_FILL_RATIO=0.70

# Replay/backtest execution costs
BACKTEST_SLIPPAGE_BPS=25

# Safety interpretation: explicit FALSE is a reject; missing audit fields remain unknown.
REQUIRE_MINT_AUTHORITY_DISABLED=true
REQUIRE_FREEZE_AUTHORITY_DISABLED=true
REJECT_SUSPICIOUS=true
