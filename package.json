{
  "name": "demkinn-sol",
  "version": "1.3.0",
  "private": false,
  "description": "Demkinn — Solana memecoin paper-trading engine with Jupiter Tokens V2 data, scoring, risk controls, telemetry and replay backtesting.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "backtest": "npm run build && node dist/src/backtest-cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
